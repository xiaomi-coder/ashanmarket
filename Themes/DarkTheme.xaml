<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ COLORS ═══════════════════════════════════════════════════════ -->
    <Color x:Key="BgDark">#FF0F1117</Color>
    <Color x:Key="BgMid">#FF1A1D27</Color>
    <Color x:Key="BgCard">#FF22263A</Color>
    <Color x:Key="BgHover">#FF2C3150</Color>
    <Color x:Key="Accent">#FF3D7FFF</Color>
    <Color x:Key="AccentHover">#FF5B96FF</Color>
    <Color x:Key="AccentGreen">#FF27AE60</Color>
    <Color x:Key="AccentRed">#FFE74C3C</Color>
    <Color x:Key="AccentOrange">#FFF39C12</Color>
    <Color x:Key="TextPrimary">#FFF0F2FF</Color>
    <Color x:Key="TextSecondary">#FF8892B0</Color>
    <Color x:Key="Border">#FF2E3460</Color>

    <!-- ═══ BRUSHES ═══════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="BrushBgDark"      Color="{StaticResource BgDark}"/>
    <SolidColorBrush x:Key="BrushBgMid"       Color="{StaticResource BgMid}"/>
    <SolidColorBrush x:Key="BrushBgCard"      Color="{StaticResource BgCard}"/>
    <SolidColorBrush x:Key="BrushBgHover"     Color="{StaticResource BgHover}"/>
    <SolidColorBrush x:Key="BrushAccent"      Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource AccentHover}"/>
    <SolidColorBrush x:Key="BrushGreen"       Color="{StaticResource AccentGreen}"/>
    <SolidColorBrush x:Key="BrushRed"         Color="{StaticResource AccentRed}"/>
    <SolidColorBrush x:Key="BrushOrange"      Color="{StaticResource AccentOrange}"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSec"     Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="BrushBorder"      Color="{StaticResource Border}"/>

</ResourceDictionary>
