<UserControl x:Class="SupermarketPOS.Views.DebtsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource BrushBgDark}"
             Foreground="{StaticResource BrushTextPrimary}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgMid}" CornerRadius="12" Padding="20" Margin="0 0 0 20">
            <TextBlock Text="Qarzlar va To'lovlar" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Debtors List -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgMid}" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Margin="0 0 0 16">
                        <TextBlock Text="Qarzdor Mijozlar" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0 0 0 12"/>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource TxtBox}" Tag="🔍 Ism yoki raqam bo'yicha qidiruv" ToolTip="Qidiruv"/>
                    </StackPanel>
                    
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredDebtors}" SelectedItem="{Binding SelectedCustomer}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0 0 0 8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#FF2E3460">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF1F2437"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3D7FFF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF2C3150"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#FF3D7FFF" Margin="0 0 12 0">
                                        <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="⚠️ Muddati o'tgan" Foreground="#FFFF4757" FontSize="12" Margin="5 2 0 0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Phone}" FontSize="13" Foreground="{StaticResource BrushTextSec}"/>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Column="2" Text="{Binding DebtBalance, StringFormat='{}{0:N0} so\'m'}" 
                                               FontSize="15" FontWeight="Bold" Foreground="#FFFF4757" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Add New Debt Section -->
                    <Border Grid.Row="2" Margin="0 16 0 0" Padding="12" Background="#FF1F2437" CornerRadius="8" BorderThickness="1" BorderBrush="#FF2E3460">
                        <StackPanel>
                            <TextBlock Text="Yangi Qarz Kiritish" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0 0 0 12"/>
                            
                            <Grid Margin="0 0 0 8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Telefon raqami (masalan: 998901234567)" FontSize="11" Foreground="{StaticResource BrushTextSec}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TxtBox}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Mijoz ismi" FontSize="11" Foreground="{StaticResource BrushTextSec}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TxtBox}"/>
                                </StackPanel>
                            </Grid>
                            
                            <Grid Margin="0 0 0 12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Qarz summasi (so'm)" FontSize="11" Foreground="{StaticResource BrushTextSec}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewDebtAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TxtBox}"/>
                                </StackPanel>
                                
                                <Button Grid.Column="2" Content="QO'SHISH" Command="{Binding AddDebtCommand}" Width="100" Height="40" VerticalAlignment="Bottom"
                                        Style="{StaticResource BtnAccent}" FontSize="12" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Details and Payment -->
            <Border Grid.Column="2" Background="{StaticResource BrushBgMid}" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCustomer}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding SelectedCustomer.Name}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Grid.Row="0" Text="{Binding SelectedCustomer.Phone}" FontSize="14" Foreground="{StaticResource BrushTextSec}" Margin="0 30 0 20"/>

                    <Grid Grid.Row="1" Margin="0 0 0 20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Pay Section -->
                        <Border Grid.Column="0" Background="#FF1F2437" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="#FF2E3460">
                            <StackPanel>
                                <TextBlock Text="Joriy Qarz:" FontSize="14" Foreground="{StaticResource BrushTextSec}"/>
                                <TextBlock Text="{Binding SelectedCustomer.DebtBalance, StringFormat='{}{0:N0} so\'m'}" FontSize="24" FontWeight="Bold" Foreground="#FFFF4757" Margin="0 4 0 16"/>
                                
                                <TextBlock Text="To'lov summasi:" FontSize="13" Foreground="{StaticResource BrushTextSec}" Margin="0 0 0 4"/>
                                <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Padding="8" Background="#FF1A1F2E" Foreground="White" BorderBrush="#FF2E3460" Margin="0 0 0 12"/>
                                
                                <Button Content="QARZNI TO'LASH" Command="{Binding PayDebtCommand}" Height="40" FontSize="14" FontWeight="Bold" Background="#FF2ED573" Foreground="White">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Add Debt Section -->
                        <Border Grid.Column="2" Background="#FF1F2437" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="#FF2E3460">
                            <StackPanel>
                                <TextBlock Text="Qarz Qo'shish:" FontSize="14" Foreground="{StaticResource BrushTextSec}"/>
                                <TextBlock Text="➕" FontSize="24" Margin="0 4 0 16" Foreground="{StaticResource BrushTextSec}"/>
                                
                                <TextBlock Text="Qo'shiladigan summa:" FontSize="13" Foreground="{StaticResource BrushTextSec}" Margin="0 0 0 4"/>
                                <TextBox Text="{Binding SelectedCustomerAddDebtAmount, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Padding="8" Background="#FF1A1F2E" Foreground="White" BorderBrush="#FF2E3460" Margin="0 0 0 12"/>
                                
                                <Button Content="QARZ QO'SHISH" Command="{Binding AddDebtToSelectedCommand}" Height="40" FontSize="14" FontWeight="Bold" Background="#FFFF4757" Foreground="White">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Term Section -->
                        <Border Grid.Column="4" Background="#FF1F2437" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="#FF2E3460">
                            <StackPanel>
                                <TextBlock Text="Qarz muddati (kun):" FontSize="14" Foreground="{StaticResource BrushTextSec}"/>
                                <TextBox Text="{Binding SelectedCustomer.DebtTermDays, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Padding="8" Background="#FF1A1F2E" Foreground="White" BorderBrush="#FF2E3460" Margin="0 4 0 16"/>
                                
                                <Button Content="SAQLASH" Command="{Binding UpdateTermCommand}" Height="40" FontSize="14" FontWeight="Bold" Background="#FF3D7FFF" Foreground="White">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- History -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Qarz Tarixi" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 12" Foreground="{StaticResource BrushTextPrimary}"/>
                        
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" IsReadOnly="True" 
                                  Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#FF1A1F2E"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FF2E3460"
                                  BorderThickness="0" Foreground="{StaticResource BrushTextPrimary}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FF1F2437"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSec}"/>
                                    <Setter Property="Padding" Value="10"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sana" Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}" Width="150"/>
                                <DataGridTextColumn Header="Turi" Binding="{Binding Type}" Width="100"/>
                                <DataGridTextColumn Header="Summa" Binding="{Binding Amount, StringFormat='{}{0:N0} so\'m'}" Width="150"/>
                                <DataGridTextColumn Header="Izoh" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
