<UserControl x:Class="SupermarketPOS.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SupermarketPOS.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource BrushBgDark}">

    <UserControl.Resources>
        <!-- BooleanToVisibilityConverter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource BrushBgCard}" CornerRadius="12" Padding="24" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="⚙️ Dastur Sozlamalari" Foreground="{StaticResource BrushTextPrimary}" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Umumiy va bulutga ulanish sozlamalari" Foreground="{StaticResource BrushTextSec}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Umumiy Sozlamalar -->
            <Border Background="{StaticResource BrushBgCard}" CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="Umumiy" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    
                    <TextBlock Text="Do'kon Nomi" Foreground="{StaticResource BrushTextSec}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource TxtBox}"
                             Margin="0,0,0,24"/>

                    <TextBlock Text="Web API URL" Foreground="{StaticResource BrushTextSec}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding BackendApiUrl, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource TxtBox}"
                             Margin="0,0,0,24"/>

                    <Button Content="Saqlash" Command="{Binding SaveCommand}" Style="{StaticResource BtnAccent}" HorizontalAlignment="Left" Width="150"/>

                    <TextBlock Text="{Binding StatusMessage}" 
                               Foreground="{StaticResource BrushGreen}" 
                               Margin="0,16,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Bulutga Ulanish -->
            <Border Grid.Column="2" Background="{StaticResource BrushBgCard}" CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="☁️ Bulutga Ulanish (Cloud Sync)" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="Mobil ilova ma'lumotlari bilan bitta!" Foreground="{StaticResource BrushTextSec}" Margin="0,0,0,16" FontSize="12"/>

                    <!-- Ulanish Holati -->
                    <Border Background="{StaticResource BrushBgDark}" CornerRadius="8" Padding="12" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Holat: " Foreground="{StaticResource BrushTextSec}"/>
                            <TextBlock Text="Ulangan" Foreground="{StaticResource BrushGreen}" FontWeight="Bold" Visibility="{Binding IsCloudConnected, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Ulanmagan" Foreground="{StaticResource BrushRed}" FontWeight="Bold" Visibility="{Binding IsCloudConnected, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Do'kon ID (Slug)" Foreground="{StaticResource BrushTextSec}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding CloudSlug, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource TxtBox}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Login" Foreground="{StaticResource BrushTextSec}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding CloudUsername, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource TxtBox}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Parol" Foreground="{StaticResource BrushTextSec}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding CloudPassword, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource TxtBox}"
                             Margin="0,0,0,24"/>

                    <Button Content="Ulanish va Tasdiqlash" Command="{Binding ConnectCloudCommand}" Style="{StaticResource BtnAccent}"/>
                    
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
