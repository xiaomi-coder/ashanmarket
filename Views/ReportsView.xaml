<UserControl x:Class="SupermarketPOS.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBgDark}">

    <UserControl.Resources>

    </UserControl.Resources>

    <DockPanel Margin="16">

        <!-- Header & filters -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0 0 0 12">
            <StackPanel>
                <TextBlock Text="📊 Savdo Hisobotlari"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           Margin="0 0 0 16"/>
                <StackPanel Orientation="Horizontal">
                    <Label Content="DAN:" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding FromDate}"
                                Width="140" Margin="4 0 16 0"/>
                    <Label Content="GACHA:" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding ToDate}"
                                Width="140" Margin="4 0 16 0"/>
                    <Button Content="🔍 Ko'rsatish"
                            Style="{StaticResource BtnAccent}"
                            Padding="16 8"
                            Command="{Binding LoadReportCommand}"
                            Margin="0 0 8 0"/>
                    <Button Content="Bugun"    Style="{StaticResource BtnBase}" Padding="12 8" Margin="0 0 4 0" Command="{Binding TodayCommand}"/>
                    <Button Content="Hafta"    Style="{StaticResource BtnBase}" Padding="12 8" Margin="0 0 4 0" Command="{Binding ThisWeekCommand}"/>
                    <Button Content="Oy"       Style="{StaticResource BtnBase}" Padding="12 8" Margin="0 0 4 0" Command="{Binding ThisMonthCommand}"/>
                    <Button Content="Yil"      Style="{StaticResource BtnBase}" Padding="12 8" Command="{Binding ThisYearCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Stats cards -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 0 0 12">

            <Border Style="{StaticResource StatCard}" Margin="0 0 8 0">
                <StackPanel>
                    <TextBlock Text="Jami sotuvlar" Foreground="{StaticResource BrushTextSec}" FontSize="11"/>
                    <TextBlock Text="{Binding TotalTransactions}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccent}"/>
                    <TextBlock Text="ta tranzaksiya" Foreground="{StaticResource BrushTextSec}" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" Margin="0 0 8 0">
                <StackPanel>
                    <TextBlock Text="Umumiy tushum" Foreground="{StaticResource BrushTextSec}" FontSize="11"/>
                    <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N0}'}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="so'm" Foreground="{StaticResource BrushTextSec}" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" Margin="0 0 8 0">
                <StackPanel>
                    <TextBlock Text="Sof foyda" Foreground="{StaticResource BrushTextSec}" FontSize="11"/>
                    <TextBlock Text="{Binding TotalProfit, StringFormat='{}{0:N0}'}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource BrushGreen}"/>
                    <TextBlock Text="so'm" Foreground="{StaticResource BrushTextSec}" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Chegirmalar" Foreground="{StaticResource BrushTextSec}" FontSize="11"/>
                    <TextBlock Text="{Binding TotalDiscount, StringFormat='{}{0:N0}'}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource BrushOrange}"/>
                    <TextBlock Text="so'm" Foreground="{StaticResource BrushTextSec}" FontSize="11"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Bottom: two panels -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Sales history -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0 0 8 0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Sotuv tarixi"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               Margin="0 0 0 10"/>
                    <ListView ItemsSource="{Binding SalesHistory}"
                              BorderThickness="0" Background="Transparent"
                              VirtualizingPanel.IsVirtualizing="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Chek №" Width="130"
                                                DisplayMemberBinding="{Binding SaleNumber}"/>
                                <GridViewColumn Header="Kassir" Width="120"
                                                DisplayMemberBinding="{Binding CashierName}"/>
                                <GridViewColumn Header="Jami" Width="100"
                                                DisplayMemberBinding="{Binding Total, StringFormat='{}{0:N0}'}"/>
                                <GridViewColumn Header="To'lov" Width="80"
                                                DisplayMemberBinding="{Binding PaymentMethod}"/>
                                <GridViewColumn Header="Sana" Width="130"
                                                DisplayMemberBinding="{Binding CreatedAt, StringFormat='{}{0:dd/MM HH:mm}'}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- Top products -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="🏆 Eng ko'p sotiladigan"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               Margin="0 0 0 10"/>
                    <ListView ItemsSource="{Binding TopProducts}"
                              BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0 4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ProductName}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{StaticResource BrushTextSec}" FontSize="11">
                                            <Run Text="{Binding QuantitySold}"/>
                                            <Run Text="ta sotildi"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Revenue, StringFormat='{}{0:N0}'}"
                                                   Foreground="{StaticResource BrushAccent}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding Profit, StringFormat='Foyda: {0:N0}'}"
                                                   Foreground="{StaticResource BrushGreen}"
                                                   FontSize="11" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
