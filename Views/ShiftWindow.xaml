<Window x:Class="SupermarketPOS.Views.ShiftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smena Boshqaruvi" Height="350" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgDark}"
        ResizeMode="NoResize">
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0 0 0 16"/>
            
            <TextBlock Text="{Binding InfoMessage}" Foreground="{StaticResource BrushTextSec}" Margin="0 0 0 16" TextWrapping="Wrap"/>
            
            <Label Content="{Binding InputLabel}" Foreground="{StaticResource BrushTextPrimary}"/>
            <TextBox Text="{Binding InputAmount, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource BarcodeInput}" FontSize="24" Margin="0 4 0 24"/>
            
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushRed}" Visibility="{Binding ErrorMessage.Length, Converter={StaticResource IntVis}}" Margin="0 0 0 8"/>
            
            <Button Content="{Binding ButtonText}" Style="{StaticResource BtnAccent}" Padding="0 12" Command="{Binding SubmitCommand}"/>
            <Button Content="Bekor qilish" Style="{StaticResource BtnBase}" Margin="0 8 0 0" Padding="0 12" Click="Cancel_Click"/>
        </StackPanel>
    </Border>
</Window>
