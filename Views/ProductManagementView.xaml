<UserControl x:Class="SupermarketPOS.Views.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SupermarketPOS.Converters"
             Background="{StaticResource BrushBgDark}">



    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: PRODUCT LIST ══════════════════════════════════════ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0 0 8 0">
            <DockPanel>

                <!-- Toolbar -->
                <DockPanel DockPanel.Dock="Top" Margin="0 0 0 12">
                    <TextBlock Text="📦 Mahsulotlar ro'yxati"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="♻ Yangilash"
                                Style="{StaticResource BtnBase}" Padding="12 7"
                                Command="{Binding RefreshCommand}" Margin="0 0 8 0"/>
                        <Button Content="📥 CSV Import"
                                Style="{StaticResource BtnAccent}" Padding="12 7"
                                Command="{Binding ImportCsvCommand}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Search -->
                <TextBox DockPanel.Dock="Top"
                         Style="{StaticResource TxtBox}"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0 0 0 10">
                    <TextBox.Resources>
                        <Style TargetType="TextBox" BasedOn="{StaticResource TxtBox}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Tag" Value="🔍  Barcode yoki nom bo'yicha qidirish..."/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Status -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           Margin="0 8 0 0"
                           Foreground="{StaticResource BrushTextSec}"/>

                <!-- Product list -->
                <ListView ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Barcode" Width="130"
                                            DisplayMemberBinding="{Binding Barcode}"/>
                            <GridViewColumn Header="Nomi" Width="180"
                                            DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Narx" Width="90"
                                            DisplayMemberBinding="{Binding Price, StringFormat='{}{0:N0}'}"/>
                            <GridViewColumn Header="Tan narx" Width="90"
                                            DisplayMemberBinding="{Binding CostPrice, StringFormat='{}{0:N0}'}"/>
                            <GridViewColumn Header="Qoldiq" Width="70"
                                            DisplayMemberBinding="{Binding Stock}"/>
                            <GridViewColumn Header="O'lchov" Width="60"
                                            DisplayMemberBinding="{Binding Unit}"/>
                            <GridViewColumn Header="Kategoriya" Width="100"
                                            DisplayMemberBinding="{Binding CategoryName}"/>
                            <GridViewColumn Header="Holat" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="✅"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="Text" Value="⚠️ Kam"/>
                                                            <Setter Property="Foreground" Value="{StaticResource BrushOrange}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Stock}" Value="0">
                                                            <Setter Property="Text" Value="❌ Yo'q"/>
                                                            <Setter Property="Foreground" Value="{StaticResource BrushRed}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- ═══ RIGHT: ADD/EDIT FORM ══════════════════════════════════ -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding IsEditMode, Converter={StaticResource BoolToStr},
                                   ConverterParameter='✏️ Mahsulotni tahrirlash|➕ Yangi mahsulot'}"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               Margin="0 0 0 20"/>

                    <Label Content="SHTRIX-KOD *"/>
                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource TxtBox}"
                                 Text="{Binding FormBarcode, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="🎲 Yaratish"
                                Style="{StaticResource BtnBase}"
                                Margin="8 0 0 0" Padding="10 0"
                                Command="{Binding GenerateBarcodeCommand}"/>
                    </Grid>

                    <Label Content="MAHSULOT NOMI *"/>
                    <TextBox Style="{StaticResource TxtBox}"
                             Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0 0 0 12"/>

                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0 0 6 0">
                            <Label Content="SOTUV NARXI *"/>
                            <TextBox Style="{StaticResource TxtBox}"
                                     Text="{Binding FormPrice, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6 0 0 0">
                            <Label Content="TAN NARXI"/>
                            <TextBox Style="{StaticResource TxtBox}"
                                     Text="{Binding FormCostPrice, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0 0 6 0">
                            <Label Content="UMUMIY QOLDIQ"/>
                            <TextBox Style="{StaticResource TxtBox}"
                                     Text="{Binding FormStock, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Faqat boshlang'ich kiritish uchun"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6 0 0 0">
                            <Label Content="KAM SIGNAL"/>
                            <TextBox Style="{StaticResource TxtBox}"
                                     Text="{Binding FormLowStock, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource BrushBgDark}" CornerRadius="6" Padding="12" Margin="0 0 0 12"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <Label Content="📥 YANGI KIRIM QILISH" FontSize="11" Foreground="{StaticResource BrushTextSec}"/>
                            <Grid Margin="0 4 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource TxtBox}"
                                         Text="{Binding FormAddStock, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Nechta qo'shilmoqda?"/>
                                <Button Grid.Column="1" Content="➕ Qo'shish"
                                        Style="{StaticResource BtnBase}"
                                        Margin="8 0 0 0" Padding="12 0"
                                        Command="{Binding AddStockCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Label Content="O'LCHOV BIRLIGI"/>
                    <ComboBox ItemsSource="{Binding Units}"
                              SelectedItem="{Binding FormUnit}"
                              Margin="0 0 0 12"/>

                    <Label Content="KATEGORIYA"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding FormCategory}"
                              DisplayMemberPath="Name"
                              Margin="0 0 0 20"/>

                    <!-- Action buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="🆕 Yangi"
                                Style="{StaticResource BtnBase}"
                                Margin="0 0 6 0"
                                Height="40"
                                Command="{Binding NewProductCommand}"/>
                        <Button Grid.Column="1"
                                Content="🗑 O'chirish"
                                Style="{StaticResource BtnRed}"
                                Margin="6 0 0 0"
                                Height="40"
                                Command="{Binding DeleteProductCommand}"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                    <Button Content="💾  SAQLASH"
                            Style="{StaticResource BtnAccent}"
                            Height="44" FontSize="14"
                            Margin="0 10 0 0"
                            Command="{Binding SaveProductCommand}"/>
                            
                    <Button Content="🖨 Shtrix-kod chop etish"
                            Style="{StaticResource BtnBase}"
                            Height="40" FontSize="13"
                            Margin="0 10 0 0"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolVis}}"
                            Command="{Binding PrintBarcodeCommand}"/>

                    <!-- Status -->
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12" TextWrapping="Wrap"
                               Margin="0 12 0 0"
                               Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
