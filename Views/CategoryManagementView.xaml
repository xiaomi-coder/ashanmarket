<UserControl x:Class="SupermarketPOS.Views.CategoryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SupermarketPOS.Converters"
             Background="{StaticResource BrushBgDark}">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullVis"/>
        <converters:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: CATEGORY LIST ══════════════════════════════════════ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0 0 8 0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0 0 0 12">
                    <TextBlock Text="📂 Kategoriyalar ro'yxati"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- DataGrid -->
                <DataGrid ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          Background="Transparent"
                          Foreground="{StaticResource BrushTextPrimary}"
                          SelectionMode="Single"
                          CanUserAddRows="False">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BrushBgMid}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextSec}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3D7FFF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10 8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Rang" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="16" Height="16" CornerRadius="8" Background="{Binding Color, Converter={StaticResource StrToBrush}}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Nomi" Binding="{Binding Name}" Width="200" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Izoh" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ═══ RIGHT: FORM ══════════════════════════════════════════════ -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8 0 0 0">
            <StackPanel>
                <TextBlock Text="{Binding IsEditing, Converter={StaticResource BoolVis}, StringFormat='Tahrirlash'}"
                           FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0 0 0 16"/>
                
                <Label Content="KATEGORIYA NOMI"/>
                <TextBox Style="{StaticResource TxtBox}" 
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0 0 0 12"/>

                <Label Content="IZOH (Ixtiyoriy)"/>
                <TextBox Style="{StaticResource TxtBox}" 
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                         Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                         Margin="0 0 0 12"/>

                <Label Content="KATEGORIYA RANGI"/>
                <ComboBox ItemsSource="{Binding AvailableColors}"
                          SelectedItem="{Binding SelectedNamedColor, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0 0 0 16">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4 2">
                                <Border Width="16" Height="16" CornerRadius="4" 
                                        Background="{Binding Hex, Converter={StaticResource StrToBrush}}"
                                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                        Margin="0 0 8 0"/>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <UniformGrid Columns="2" Margin="0 0 0 8">
                    <Button Content="Tozalash" Style="{StaticResource BtnBase}" Command="{Binding ClearCommand}" Margin="0 0 4 0"/>
                    <Button Content="Saqlash" Style="{StaticResource BtnAccent}" Command="{Binding SaveCommand}" Margin="4 0 0 0"/>
                </UniformGrid>

                <Button Content="O'chirish" Style="{StaticResource BtnBase}" Foreground="{StaticResource BrushRed}"
                        Command="{Binding DeleteCommand}"
                        Visibility="{Binding SelectedCategory, Converter={StaticResource NullVis}}"
                        Margin="0 8 0 0"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
