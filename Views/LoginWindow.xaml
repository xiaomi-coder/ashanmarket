<Window x:Class="SupermarketPOS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SupermarketPOS — Kirish"
        Width="420" Height="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border CornerRadius="12" Background="{StaticResource BrushBgMid}"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource BrushBgDark}"
                    CornerRadius="12 12 0 0" MouseLeftButtonDown="TitleBar_Drag">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0 0 12 0">
                    <Button Content="✕" Width="32" Height="32"
                            Style="{StaticResource BtnBase}"
                            Background="Transparent"
                            Foreground="{StaticResource BrushTextSec}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="48" VerticalAlignment="Center">

                <!-- Logo -->
                <TextBlock Text="🛒" FontSize="52" HorizontalAlignment="Center"
                           Margin="0 0 0 8"/>
                <TextBlock Text="SUPERMARKET POS"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"/>
                <TextBlock Text="Tizimga kiring"
                           FontSize="13"
                           Foreground="{StaticResource BrushTextSec}"
                           HorizontalAlignment="Center"
                           Margin="0 4 0 32"/>

                <!-- Username -->
                <Label Content="FOYDALANUVCHI NOMI" Margin="0 0 0 4"/>
                <TextBox Style="{StaticResource TxtBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="Input_KeyDown"/>

                <Label Content="PAROL" Margin="0 16 0 4"/>
                <PasswordBox x:Name="PasswordBox"
                             Background="{StaticResource BrushBgMid}"
                             Foreground="{StaticResource BrushTextPrimary}"
                             CaretBrush="{StaticResource BrushAccent}"
                             BorderBrush="{StaticResource BrushBorder}"
                             BorderThickness="1"
                             Padding="10 8"
                             FontSize="13"
                             KeyDown="Input_KeyDown"/>

                <!-- Error message -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource BrushRed}"
                           FontSize="12"
                           Margin="0 12 0 0"
                           TextWrapping="Wrap"/>

                <!-- Login Button -->
                <Button Content="KIRISH"
                        Style="{StaticResource BtnAccent}"
                        Margin="0 24 0 0"
                        Height="44"
                        FontSize="14"
                        FontWeight="Bold"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordBox}"
                        Click="LoginButton_Click"/>

                <TextBlock Text="admin / admin123  •  kassir / kassir123"
                           FontSize="11"
                           Foreground="{StaticResource BrushTextSec}"
                           HorizontalAlignment="Center"
                           Margin="0 16 0 0"
                           Opacity="0.6"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
