<UserControl x:Class="SupermarketPOS.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBgDark}"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="PaymentRadio" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{StaticResource BrushBgCard}" 
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" 
                                CornerRadius="8" Padding="12 12" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0 0 8 0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ COL 0: POS CATEGORY & PRODUCT GRID ═══════════════════════ -->
        <Border Grid.Column="0" Margin="16 16 8 16" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Categories -->
                <ListBox Grid.Row="0" ItemsSource="{Binding Categories}" 
                         SelectedItem="{Binding SelectedCategory}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Margin="0 0 0 20">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0 0 12 0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="{StaticResource BrushBgDark}" 
                                                BorderThickness="1" BorderBrush="{StaticResource BrushBorder}"
                                                CornerRadius="18" Padding="24 10"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                            <TextBlock x:Name="txt" Text="{Binding Name}" 
                                                       Foreground="{StaticResource BrushTextSec}" 
                                                       FontWeight="SemiBold" FontSize="14"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushBgHover}"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushAccent}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                
                <!-- Products -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-8 0 0 0">
                    <ItemsControl ItemsSource="{Binding CategoryProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="8" Width="170" Height="140"
                                        Cursor="Hand" Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{StaticResource BrushBgDark}" 
                                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" 
                                                    CornerRadius="16" Padding="16"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="{Binding Name}" TextWrapping="Wrap" 
                                                               Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="15"
                                                               VerticalAlignment="Top" HorizontalAlignment="Left" LineHeight="20"/>
                                                    
                                                    <Border Grid.Row="1" Background="#1A27AE60" CornerRadius="8" Padding="10 6" HorizontalAlignment="Left" Margin="0 8 0 0">
                                                        <TextBlock Text="{Binding Price, StringFormat='{}{0:N0} sum'}"
                                                                   Foreground="{StaticResource BrushGreen}" FontWeight="Bold" FontSize="14"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushBgCard}"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                    <!-- Slight scale effect on hover -->
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══ COL 1: PRODUCT SEARCH + CART ════════════════════════════ -->
        <DockPanel Grid.Column="1" Margin="8 16 8 16">

            <!-- Barcode input -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0 0 0 12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="SHTRIX-KOD / QIDIRISH"/>
                        <TextBox x:Name="BarcodeBox"
                                 Style="{StaticResource BarcodeInput}"
                                 Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Shtrix-kod o'qiting yoki mahsulot nomini kiriting"
                                 KeyDown="BarcodeBox_KeyDown"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="➕ QO'SHISH"
                            Style="{StaticResource BtnAccent}"
                            Margin="12 20 0 0"
                            Padding="20 12"
                            FontSize="14"
                            Command="{Binding ScanBarcodeCommand}"/>
                </Grid>
            </Border>

            <!-- Search results -->
            <Border DockPanel.Dock="Top"
                    Style="{StaticResource Card}"
                    Margin="0 0 0 12"
                    MaxHeight="200"
                    Visibility="{Binding SearchResults.Count, Converter={StaticResource IntVis}}">
                <StackPanel>
                    <Label Content="QIDIRUV NATIJALARI"/>
                    <ListView ItemsSource="{Binding SearchResults}"
                              BorderThickness="0" Background="Transparent"
                              MaxHeight="150">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Barcode" Width="130"
                                                DisplayMemberBinding="{Binding Barcode}"/>
                                <GridViewColumn Header="Nomi" Width="200"
                                                DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Narx" Width="90"
                                                DisplayMemberBinding="{Binding Price, StringFormat='{}{0:N0}'}"/>
                                <GridViewColumn Header="Qoldiq" Width="70"
                                                DisplayMemberBinding="{Binding Stock}"/>
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <EventSetter Event="MouseDoubleClick" Handler="SearchItem_DoubleClick"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Cart items -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0 0 0 8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="SAVAT" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding CartItems.Count, StringFormat='({0} ta)'}" Foreground="{StaticResource BrushTextSec}" VerticalAlignment="Center" Margin="6 0 0 0"/>
                        
                        <Button Grid.Column="3" Content="⏸ Kutishga olish" Style="{StaticResource BtnBase}" Padding="10 4" Margin="0 0 8 0" FontSize="11" Command="{Binding HoldCartCommand}"/>
                        <Button Grid.Column="4" Content="🗑 Tozalash" Style="{StaticResource BtnRed}" Padding="10 4" FontSize="11" Command="{Binding ClearCartCommand}"/>
                    </Grid>

                    <!-- Kutilayotgan savatlar -->
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding HeldCarts}" Margin="0 0 0 12"
                                  Visibility="{Binding HeldCarts.Count, Converter={StaticResource IntVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Summary}" Margin="0 0 8 8" Padding="12 6"
                                        Style="{StaticResource BtnBase}" BorderThickness="1" BorderBrush="{StaticResource BrushAccent}"
                                        Command="{Binding DataContext.ResumeCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Davom ettirish uchun bosing"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ListView ItemsSource="{Binding CartItems}"
                              SelectedItem="{Binding SelectedItem}"
                              BorderThickness="0" Background="Transparent">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Mahsulot" Width="220"
                                                DisplayMemberBinding="{Binding ProductName}"/>
                                <GridViewColumn Header="Narx" Width="90"
                                                DisplayMemberBinding="{Binding UnitPrice, StringFormat='{}{0:N0}'}"/>
                                <GridViewColumn Header="Soni" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="−" Width="24" Height="24"
                                                        Style="{StaticResource BtnBase}"
                                                        Padding="0"
                                                        FontSize="16"
                                                        Tag="{Binding}"
                                                        Click="DecreaseQty_Click"/>
                                                <TextBlock Text="{Binding Quantity}"
                                                           Width="30" TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                                <Button Content="+" Width="24" Height="24"
                                                        Style="{StaticResource BtnAccent}"
                                                        Padding="0"
                                                        FontSize="14"
                                                        Tag="{Binding}"
                                                        Click="IncreaseQty_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Jami" Width="90"
                                                DisplayMemberBinding="{Binding Total, StringFormat='{}{0:N0}'}"/>
                                <GridViewColumn Header="" Width="36">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Width="28" Height="28"
                                                    Style="{StaticResource BtnRed}"
                                                    Padding="0" FontSize="11"
                                                    Tag="{Binding}"
                                                    Click="RemoveItem_Click"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

        </DockPanel>

        <!-- ═══ COL 2: PAYMENT PANEL ════════════════════════════════════ -->
        <Grid Grid.Column="2" Margin="8 16 16 16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="TO'LOV" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSec}"
                               Margin="0 0 0 16"/>

                    <!-- Totals display -->
                    <Border Background="{StaticResource BrushBgDark}"
                            CornerRadius="8" Padding="16" Margin="0 0 0 16">
                        <StackPanel>
                            <Grid Margin="0 4">
                                <TextBlock Text="Jami:" Foreground="{StaticResource BrushTextSec}"/>
                                <TextBlock Text="{Binding SubTotal, StringFormat='{}{0:N0}'}"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="14"/>
                            </Grid>
                            <Separator/>
                            <Grid Margin="0 8">
                                <TextBlock Text="JAMI TO'LOV:" FontWeight="Bold"
                                           FontSize="15"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="{Binding Total, StringFormat='{}{0:N0}'}"
                                           HorizontalAlignment="Right" FontWeight="Bold"
                                           FontSize="22"
                                           Foreground="{StaticResource BrushAccent}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Payment method -->
                    <Label Content="TO'LOV TURI"/>
                    <UniformGrid Columns="3" Margin="0 4 0 12">
                        <RadioButton Content="💵 Naqd" Style="{StaticResource PaymentRadio}"
                                     IsChecked="True" 
                                     Command="{Binding DataContext.SetPaymentMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     CommandParameter="Naqd"/>
                        <RadioButton Content="💳 Karta" Style="{StaticResource PaymentRadio}"
                                     Command="{Binding DataContext.SetPaymentMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     CommandParameter="Karta"/>
                        <RadioButton Content="📱 Transfer" Style="{StaticResource PaymentRadio}" Margin="0"
                                     Command="{Binding DataContext.SetPaymentMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     CommandParameter="Transfer"/>
                    </UniformGrid>

                    <!-- Amount paid -->
                    <Label Content="QABUL QILINDI (so'm)"/>
                    <Grid Margin="0 0 0 8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource TxtBox}"
                                 Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18" FontWeight="Bold"/>
                        <Button Grid.Column="1"
                                Content="="
                                Style="{StaticResource BtnBase}"
                                Margin="8 0 0 0"
                                Width="46"
                                FontSize="18" FontWeight="Bold"
                                Command="{Binding SetAmountExactCommand}"
                                ToolTip="Jami summani aynan o'zini to'lash (Aniq)"/>
                    </Grid>

                    <!-- Quick amount buttons -->
                    <WrapPanel Margin="0 0 0 16">
                        <Button Content="10 000" Style="{StaticResource BtnBase}" Margin="0 4 4 0"
                                Tag="10000" Click="QuickAmount_Click"/>
                        <Button Content="20 000" Style="{StaticResource BtnBase}" Margin="0 4 4 0"
                                Tag="20000" Click="QuickAmount_Click"/>
                        <Button Content="50 000" Style="{StaticResource BtnBase}" Margin="0 4 4 0"
                                Tag="50000" Click="QuickAmount_Click"/>
                        <Button Content="100 000" Style="{StaticResource BtnBase}" Margin="0 4 4 0"
                                Tag="100000" Click="QuickAmount_Click"/>
                    </WrapPanel>

                    <!-- Change -->
                    <Border Background="{StaticResource BrushBgDark}"
                            CornerRadius="8" Padding="12" Margin="0 0 0 20">
                        <Grid>
                            <TextBlock Text="QAYTIM:" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSec}"/>
                            <TextBlock Text="{Binding Change, StringFormat='{}{0:N0}'}"
                                       HorizontalAlignment="Right"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource BrushGreen}"/>
                        </Grid>
                    </Border>

                    <!-- Status -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{Binding HasError, Converter={StaticResource StatusColor}}"
                               FontSize="12" TextWrapping="Wrap" Margin="0 0 0 8"/>

                    <!-- Complete button (F5) -->
                    <Button Content="✅  SOTUVNI YAKUNLASH  (F5)"
                            Style="{StaticResource BtnGreen}"
                            Height="54"
                            FontSize="15"
                            Command="{Binding CompleteSaleCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ RECEIPT OVERLAY ══════════════════════════════════════════ -->
        <Grid Grid.ColumnSpan="2"
              Background="#CC000000"
              Visibility="{Binding ShowReceipt, Converter={StaticResource BoolVis}}">
            <Border Style="{StaticResource Card}"
                    MaxWidth="500" MaxHeight="600"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 0 0 12">
                        <TextBlock Text="🧾 CHEK" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Button Content="✕ Yopish"
                                Style="{StaticResource BtnBase}"
                                HorizontalAlignment="Right"
                                Command="{Binding CloseReceiptCommand}"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding LastReceiptText}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Background="{StaticResource BrushBgMid}"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 BorderThickness="0"
                                 Padding="12"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
