<UserControl x:Class="SupermarketPOS.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1A1F2E"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="PaymentRadio" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#FF1F2437" 
                                BorderBrush="#FF2E3460" BorderThickness="1" 
                                CornerRadius="8" Padding="0" Cursor="Hand" Margin="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 10"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3D7FFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF3D7FFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="NumpadBtn" TargetType="Button">
            <Setter Property="Background" Value="#FF1F2437"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF2E3460"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF2C3150"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF3D7FFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="210"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ 1-USTUN: MAHSULOTLAR ═══════════════════════════════════════ -->
        <Grid Grid.Column="0" Margin="16 16 8 16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search & Barcode -->
            <Grid Grid.Row="0" Margin="0 0 0 16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Background="#FF1F2437" CornerRadius="8" BorderBrush="#FF2E3460" BorderThickness="1" Height="44">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="12 0 8 0" Foreground="#FF8892B0"/>
                        <TextBox x:Name="BarcodeBox" Grid.Column="1" 
                                 Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="BarcodeBox_KeyDown"
                                 Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Mahsulot nomi yoki barcode... (F2)"/>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Width="44" Height="44" Margin="8 0 0 0"
                        Background="#FF3D7FFF" Foreground="White" BorderThickness="0"
                        Content="📄" FontSize="18" ToolTip="Katalog">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Grid.Column="2" Height="44" Margin="8 0 0 0" Padding="12 0"
                        Background="#FF1F2437" Foreground="#FF8892B0" BorderThickness="1" BorderBrush="#FF2E3460"
                        Content="🔲 Barcode" Command="{Binding ScanBarcodeCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Categories -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" 
                     SelectedItem="{Binding SelectedCategory}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     PreviewMouseWheel="Categories_PreviewMouseWheel"
                     Margin="0 0 0 16">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0 0 8 0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="#FF1F2437" 
                                            BorderThickness="1" BorderBrush="#FF2E3460"
                                            CornerRadius="16" Padding="16 8">
                                        <TextBlock x:Name="txt" Text="{Binding Name}" 
                                                   Foreground="#FF8892B0" 
                                                   FontWeight="SemiBold" FontSize="13"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FF3D7FFF"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#FF3D7FFF"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Products -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CategoryProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="4" Height="100"
                                    Cursor="Hand" Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#FF1F2437" 
                                                BorderBrush="#FF2E3460" BorderThickness="1" 
                                                CornerRadius="12" Padding="12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <Grid Grid.Row="0">
                                                    <TextBlock Text="📦" FontSize="16"/>
                                                    <TextBlock Text="+" Foreground="#FF8892B0" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 -4 -4 0"/>
                                                </Grid>

                                                <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap" 
                                                           Foreground="White" FontWeight="SemiBold" FontSize="13"
                                                           VerticalAlignment="Center" Margin="0 4 0 0"/>
                                                
                                                <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0 4 0 0">
                                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:N0} so\'m'}"
                                                               Foreground="#FF3D7FFF" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Margin="0 2 0 0" FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Stock, StringFormat='✓ {0} ta bor'}"/>
                                                                <Setter Property="Foreground" Value="#FF27AE60"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding Stock, StringFormat='⚠️ {0} ta qoldi'}"/>
                                                                        <Setter Property="Foreground" Value="#FFF39C12"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Stock}" Value="0">
                                                                        <Setter Property="Text" Value="❌ Tugagan"/>
                                                                        <Setter Property="Foreground" Value="#FFE74C3C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#FF2C3150"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF3D7FFF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ═══ 2-USTUN: SAVAT (240px) ══════════════════════════════════════ -->
        <Border Grid.Column="1" Background="#FF1A1D27" BorderBrush="#FF2E3460" BorderThickness="1" CornerRadius="12" Margin="0 16 8 16" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0 0 0 12">
                    <TextBlock Text="🛒 Savat" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <Button Content="Tozalash" Foreground="#FFE74C3C" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" FontSize="11" Cursor="Hand" Command="{Binding ClearCartCommand}"/>
                </Grid>

                <!-- Cart List -->
                <ListView Grid.Row="1" ItemsSource="{Binding CartItems}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0 0 0 1" BorderBrush="#FF2E3460" Padding="0 8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding ProductName}" Foreground="White" FontSize="12" TextWrapping="Wrap" Margin="0 0 0 4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding UnitPrice, StringFormat='{}{0:N0} x 1'}" Foreground="#FF8892B0" FontSize="11" VerticalAlignment="Center"/>
                                    
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Background="#FF1F2437" CornerRadius="4" BorderBrush="#FF2E3460" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="−" Width="20" Height="20" Background="Transparent" BorderThickness="0" Foreground="White" Tag="{Binding}" Click="DecreaseQty_Click"/>
                                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="35" TextAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12"/>
                                                <Button Content="+" Width="20" Height="20" Background="Transparent" BorderThickness="0" Foreground="White" Tag="{Binding}" Click="IncreaseQty_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Total, StringFormat='{}{0:N0}'}" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="8 0"/>
                                        <Button Content="🗑" Width="20" Height="20" Background="Transparent" BorderThickness="0" Foreground="#FFE74C3C" FontSize="12" Tag="{Binding}" Click="RemoveItem_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Discount & Totals -->
                <StackPanel Grid.Row="2" Margin="0 12 0 0">
                    <Border Background="#FF1F2437" CornerRadius="6" BorderBrush="#FF2E3460" BorderThickness="1" Padding="8" Margin="0 0 0 12">
                        <Grid>
                            <TextBlock Text="% Chegirma (% yoki so'm)" Foreground="#FF8892B0" FontSize="11" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" 
                                     Foreground="#FF27AE60" Background="Transparent" BorderThickness="0" 
                                     FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" 
                                     VerticalAlignment="Center" Width="80" TextAlignment="Right"/>
                        </Grid>
                    </Border>
                    <Grid Margin="0 0 0 4">
                        <TextBlock Text="{Binding CartItems.Count, StringFormat='Mahsulotlar ({0})'}" Foreground="#FF8892B0" FontSize="12"/>
                        <TextBlock Text="{Binding SubTotal, StringFormat='{}{0:N0}'}" Foreground="#FF8892B0" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0 0 0 8">
                        <TextBlock Text="Chegirma" Foreground="#FF27AE60" FontSize="12"/>
                        <TextBlock Text="{Binding Discount, StringFormat='{}{0:N0}'}" Foreground="#FF27AE60" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Jami:" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Total, StringFormat='{}{0:N0}'}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <!-- Held Carts List -->
                <ItemsControl Grid.Row="3" ItemsSource="{Binding HeldCarts}" Margin="0 16 0 0" Visibility="{Binding HeldCarts.Count, Converter={StaticResource IntVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Summary}" Margin="0 0 4 4" Padding="8 4" Height="30" FontSize="11"
                                    Background="#FF2C3150" Foreground="White" BorderBrush="#FF3D7FFF" BorderThickness="1"
                                    Command="{Binding DataContext.ResumeCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ToolTip="Davom ettirish uchun bosing">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Hold Cart -->
                <Button Grid.Row="4" Background="#FF1F2437" Foreground="#FFF39C12" 
                        BorderBrush="#FFF39C12" BorderThickness="1" 
                        Margin="0 12 0 0" Height="36" Command="{Binding HoldCartCommand}">
                    <Button.Content>
                        <TextBlock>
                            <Run Text="⏸ Kutishga qo'y | " />
                            <Run Text="{Binding HeldCarts.Count, Mode=OneWay}" />
                            <Run Text=" ta kutilmoqda" />
                        </TextBlock>
                    </Button.Content>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ 3-USTUN: TO'LOV (210px) ═══════════════════════════════════ -->
        <Border Grid.Column="2" Background="#FF1A1D27" BorderBrush="#FF2E3460" BorderThickness="1" CornerRadius="12" Margin="0 16 16 16" Padding="12">
            <StackPanel>
                <!-- Payment Types -->
                <TextBlock Text="💳 To'lov turi" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0 0 0 8"/>
                <UniformGrid Columns="2">
                    <RadioButton Content="Naqd" Style="{StaticResource PaymentRadio}" IsChecked="True" Command="{Binding DataContext.SetPaymentMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Naqd"/>
                    <RadioButton Content="Karta" Style="{StaticResource PaymentRadio}" Command="{Binding DataContext.SetPaymentMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Karta"/>
                    <RadioButton Content="Transfer" Style="{StaticResource PaymentRadio}" Command="{Binding DataContext.SetPaymentMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Transfer"/>
                    <RadioButton Content="Qarz" Style="{StaticResource PaymentRadio}" Command="{Binding DataContext.SetPaymentMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Qarz"/>
                </UniformGrid>

                <!-- Customer Details for Qarz -->
                <StackPanel Visibility="{Binding IsQarz, Converter={StaticResource BoolVis}}" Margin="0 8 0 0">
                    <TextBlock Text="Mijoz ismi (majburiy):" Foreground="#FF8892B0" FontSize="11" Margin="0 4 0 4"/>
                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Background="#FF1F2437" Foreground="White" BorderBrush="#FF2E3460" Padding="8 4" Height="30"/>
                    
                    <TextBlock Text="Telefon (majburiy):" Foreground="#FF8892B0" FontSize="11" Margin="0 8 0 4"/>
                    <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" Background="#FF1F2437" Foreground="White" BorderBrush="#FF2E3460" Padding="8 4" Height="30"/>
                </StackPanel>

                <!-- Amount Paid -->
                <TextBlock Text="Qabul qilindi (so'm)" Foreground="#FF8892B0" FontSize="11" Margin="0 16 0 4"/>
                <TextBox Style="{StaticResource TxtBox}" 
                         Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged}"
                         Background="#FF1F2437" BorderBrush="#FF2E3460" BorderThickness="1" Foreground="White" 
                         FontSize="20" FontWeight="Bold" Height="40" VerticalContentAlignment="Center" Padding="8 0"/>

                <!-- Numpad -->
                <Grid Margin="0 16 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                    </Grid.RowDefinitions>
                    <!-- Row 1 -->
                    <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource NumpadBtn}" Margin="2" Tag="1" Click="Numpad_Click"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource NumpadBtn}" Margin="2" Tag="2" Click="Numpad_Click"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource NumpadBtn}" Margin="2" Tag="3" Click="Numpad_Click"/>
                    <!-- Row 2 -->
                    <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumpadBtn}" Margin="2" Tag="4" Click="Numpad_Click"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumpadBtn}" Margin="2" Tag="5" Click="Numpad_Click"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumpadBtn}" Margin="2" Tag="6" Click="Numpad_Click"/>
                    <!-- Row 3 -->
                    <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource NumpadBtn}" Margin="2" Tag="7" Click="Numpad_Click"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource NumpadBtn}" Margin="2" Tag="8" Click="Numpad_Click"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource NumpadBtn}" Margin="2" Tag="9" Click="Numpad_Click"/>
                    <!-- Row 4 -->
                    <Button Grid.Row="3" Grid.Column="0" Content="Aniq" Style="{StaticResource NumpadBtn}" Margin="2" FontSize="16" Foreground="#FF3D7FFF" Command="{Binding SetAmountExactCommand}"/>
                    <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource NumpadBtn}" Margin="2" Tag="0" Click="Numpad_Click"/>
                    <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{StaticResource NumpadBtn}" Margin="2" FontSize="20" Tag="BACK" Click="Numpad_Click"/>
                </Grid>

                <Border BorderBrush="#FF2E3460" BorderThickness="0 1 0 0" Margin="0 16 0 16"/>

                <!-- Change -->
                <Grid Margin="0 0 0 16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Qaytim:" Foreground="#FF8892B0" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Change, StringFormat='{}{0:N0} so\'m'}" Foreground="#FF27AE60" FontSize="18" FontWeight="Bold"/>
                </Grid>

                <!-- Receipt Options -->
                <Grid Margin="0 0 0 16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="🧾 Chek" Background="#FF1F2437" Foreground="White" BorderThickness="1" BorderBrush="#FF2E3460" Margin="0 0 4 0" Height="32" FontSize="11">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                    <Button Grid.Column="1" Content="📱 SMS" Background="#FF1F2437" Foreground="#FF8892B0" BorderThickness="1" BorderBrush="#FF2E3460" Margin="4 0 0 0" Height="32" FontSize="11">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                </Grid>

                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}" Foreground="#FFE74C3C" FontSize="11" TextWrapping="Wrap" Margin="0 0 0 8" HorizontalAlignment="Center"/>

                <!-- Complete Button -->
                <Button Content="✅ SOTUVNI YAKUNLASH (F5)" 
                        Background="#FF3D7FFF" Foreground="White" 
                        BorderThickness="0" Height="50" FontSize="12" FontWeight="Bold"
                        Command="{Binding CompleteSaleCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══ RECEIPT OVERLAY ══════════════════════════════════════════ -->
        <Grid Grid.ColumnSpan="3" Background="#CC000000" Visibility="{Binding ShowReceipt, Converter={StaticResource BoolVis}}">
            <Border Background="#FF1A1D27" BorderBrush="#FF2E3460" BorderThickness="1" CornerRadius="12" MaxWidth="400" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 0 0 12">
                        <TextBlock Text="🧾 CHEK" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Content="✕ Yopish" Background="Transparent" BorderThickness="0" Foreground="#FFE74C3C" HorizontalAlignment="Right" Command="{Binding CloseReceiptCommand}"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding LastReceiptText}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="#FF1F2437" Foreground="White" BorderThickness="0" Padding="12"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
